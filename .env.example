# Copy this file to .env and fill in real values before running docker compose.
# Never commit .env to Git.

# Database credentials
DB_USER=task_user
DB_NAME=task_db
DB_PASSWORD=change_me_strong_password
DB_ROOT_PASSWORD=change_me_strong_root_password

# Flask secret key (min 32 random characters)
SECRET_KEY=change_me_min_32_chars_random_string

# Google Gemini AI API key
GEMINI_API_KEY=your_gemini_api_key_here
